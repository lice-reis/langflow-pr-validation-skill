# Provider API keys and credentials for Langflow PR auto-testing
# This file is sourced by the skill before running provider tests.
# DO NOT commit this file to version control.
#
# IMPORTANT: The variable names HERE are not the same as the variable names
# you must create in the Langflow DB. See agents/provider-smoke-tester.md for
# the canonical Langflow variable names. Specifically:
#   - Here LANGFLOW_GOOGLE_API_KEY  -> in Langflow create as GOOGLE_API_KEY
#   - Here WATSONX_API_KEY          -> in Langflow create as WATSONX_APIKEY (no underscore)
#   - Here OPENAI_API_KEY           -> same name in Langflow
#   - Here ANTHROPIC_API_KEY        -> same name in Langflow
#   - Here OLLAMA_BASE_URL          -> same name in Langflow

# OpenAI (Orion)
OPENAI_API_KEY=

# Google (Gemini)
LANGFLOW_GOOGLE_API_KEY=

# IBM Watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# Anthropic (Alice Orion)
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=

# TypeSafe (Jev decision model)
TYPESAFE_API_KEY=

# Perplexity (decision models)
PERPLEXITY_API_KEY=
